# SMTP configuration for the contact form (src/app/api/contact/route.ts)
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Address that receives messages sent through the contact form
CONTACT_TO_EMAIL=anas0gabbadi@gmail.com

